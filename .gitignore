node_modules
dist
.vite
*.local

# Large binary outputs — keep these locally but never commit
*.mp4
*.zip

# Exception: commit the compressed web videos served by the frontend viewer
!frontend/public/footage/**/*_web.mp4
# That includes the 8-bit H.264 fallbacks (`*_stabilized_h264_web.mp4`,
# from 06_compress_for_web.py --codec h264 --crf 28) for devices with no HEVC
# decoder. Keep every committed video under GitHub's 100 MB per-file limit.

# Local agent settings and private submission drafts — never commit
.claude/
opencall/

# Stabilize pipeline intermediate / output files (regenerable from raw mp4 + viewer)
videos/**/*_offsets.json
videos/**/*_measured_rotation.json
videos/**/frame_to_utc.json

# Viewer reference-frame export (regenerable from the viewer's EXPORT REFERENCE FRAMES button)
stereo-moon-reference-frames/

# Python venv + caches
.venv
__pycache__
*.pyc

# OS junk
.DS_Store
.gstack/
